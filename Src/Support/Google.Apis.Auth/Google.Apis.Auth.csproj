<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">

  <Import Project="..\CommonProjectProperties.xml" />

  <!-- build configuration -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- AOT: the net10.0 target is validated for trimming/AOT (see Google.Apis.Core.csproj). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Clast: republished under a Clast.* identity only when -p:Clast=true (see Google.Apis.Core.csproj). -->
  <PropertyGroup Condition="'$(Clast)' == 'true'">
    <PackageId>Clast.Google.Apis.Auth</PackageId>
    <AssemblyName>Clast.Google.Apis.Auth</AssemblyName>
    <AssemblyOriginatorKeyFile Condition="'$(ClastKeyPath)' != ''">$(ClastKeyPath)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- nupkg information -->
  <PropertyGroup>
    <Title>Google APIs Client Library</Title>
    <Description>
The Google APIs Client Library is a runtime client for working with Google services.

This package includes auth components like user-credential, authorization code flow, etc. for making authenticated calls using the OAuth2 spec.
    </Description>
  </PropertyGroup>

  <!-- package references; common then per-target -->
  <ItemGroup>
    <ProjectReference Include="..\Google.Apis.Core\Google.Apis.Core.csproj" />
    <ProjectReference Include="..\Google.Apis\Google.Apis.csproj" />

    <PackageReference Include="ConfigureAwaitChecker.Analyzer" Version="5.0.0.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="System.Management" Version="7.0.2" />
  </ItemGroup>

  <!-- System.Management (WMI, used only for the Windows GCE BIOS fast-path in ComputeCredential) is not
       trimming/AOT-compatible, so it is intentionally NOT referenced on the AOT target (net10.0); that path
       is compiled out there. See BEHAVIORAL-CHANGES.md BC-019. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0'">
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="OAuth2/AwsExternalAccountCredential.*.cs">
      <DependentUpon>OAuth2/AwsExternalAccountCredential.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>