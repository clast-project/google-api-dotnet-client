<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  
  <Import Project="..\CommonProjectProperties.xml" />

  <!-- build configuration -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <!-- AOT: the net10.0 target is validated for trimming/AOT. The two reflection-over-generated-types paths
       (enum [StringValue] conversion in Utilities; request-parameter discovery in RequestParameterDescriptorProvider)
       are now source-generated per client into EnumStringValueRegistry / RequestParameterRegistry, so no reflection
       is needed on this target. UriPatcher is a no-op on net5+. The serialization path is source-generated STJ. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>


  <!-- Clast: when built with -p:Clast=true, republish under a Clast.* package id/assembly name and the Clast.snk key
       (namespaces/type names stay the same). Default (flag off) keeps the original identity, so the in-repo test
       projects build and run exactly as before. Pass -p:ClastKeyPath=<path-to-Clast.snk> to re-sign. -->
  <PropertyGroup Condition="'$(Clast)' == 'true'">
    <PackageId>Clast.Google.Apis.Core</PackageId>
    <AssemblyName>Clast.Google.Apis.Core</AssemblyName>
    <AssemblyOriginatorKeyFile Condition="'$(ClastKeyPath)' != ''">$(ClastKeyPath)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- nupkg information -->
  <PropertyGroup>
    <Title>Google APIs Core Client Library</Title>
    <Description>
The Google APIs Core Library contains the Google APIs HTTP layer, JSON support, Data-store, logging and so on.
    </Description>
  </PropertyGroup>
  
  <!-- package references; common then per-target -->
  <ItemGroup>
    <PackageReference Include="ConfigureAwaitChecker.Analyzer" Version="5.0.0.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- System.Text.Json provides the source-generated serializer. It is in-box on net8.0 and net10.0;
       on netstandard2.0 the package supplies both the runtime and the source generator. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../third_party/System.Net.Http/GzipDeflateHandler.cs" />
    <Compile Include="../../../third_party/System.Net.Http/StreamReplacingHttpContent.cs" />
  </ItemGroup>
  
  <!-- Clast: NuGet metadata stating this is the Clast republish. Placed last so it overrides the upstream
       Title/Description/Authors/URLs. Only applied with -p:Clast=true. -->
  <PropertyGroup Condition="'$(Clast)' == 'true'">
    <Title>Clast republish of Google.Apis.Core</Title>
    <Authors>clast-project</Authors>
    <Company>clast-project</Company>
    <Copyright>Clast republish. Based on Google.Apis.Core (Apache-2.0, Copyright Google LLC).</Copyright>
    <PackageProjectUrl>https://github.com/clast-project/google-api-dotnet-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/clast-project/google-api-dotnet-client</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Clast republish of Google.Apis.Core: Newtonsoft.Json replaced with source-generated System.Text.Json, trimming/AOT-compatible, adds a net10.0 target. Namespaces and public type names are unchanged. Independent republish from the clast-project fork — not an official Google package.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(Clast)' == 'true'">
    <None Include="..\..\..\CLAST_NUGET.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
