<Project Sdk="Microsoft.NET.Sdk">

  <!-- Clast: Native-AOT smoke test. Published with PublishAot and RUN by clast-ci.yml, to catch what the
       IsAotCompatible analyzers on the libraries cannot: a schema/request missing from a client's committed
       *.JsonContext.cs only fails at runtime, once reflection-based serialization is disabled. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Any trim/AOT warning from our code or the referenced Clast libraries fails the publish. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\Support\Google.Apis.Auth\Google.Apis.Auth.csproj" />
    <ProjectReference Include="..\..\Src\Generated\Google.Apis.Storage.v1\Google.Apis.Storage.v1.csproj" />
    <ProjectReference Include="..\..\Src\Generated\Google.Apis.Bigquery.v2\Google.Apis.Bigquery.v2.csproj" />
    <ProjectReference Include="..\..\Src\Generated\Google.Apis.Gmail.v1\Google.Apis.Gmail.v1.csproj" />
  </ItemGroup>

</Project>
